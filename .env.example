# Copy this file to .env and adjust it. Every variable below maps to a field of
# EnvSettings in clipperx/config.py; names are case-insensitive. Relative paths
# are resolved from the project root.

# --- LLM provider ------------------------------------------------------------
# LLM inference is disabled by default. Point these at any OpenAI-compatible API
# (hosted or local) that supports JSON schema output and image inputs.
# Values: disabled | openai_compatible | ollama (legacy llm.py also accepts
# auto | google | anthropic | openai | proxy).
LLM_PROVIDER=disabled
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=
OPENAI_MODEL=your-model-name
OPENAI_VISION_MODEL=your-vision-model-name
# Context window (tokens) assumed for the configured model.
LLM_NUM_CTX=65536
# Used only when LLM_PROVIDER=ollama (the /v1 suffix is added automatically).
OLLAMA_BASE_URL=http://localhost:11434
# Used only by the legacy pipeline when LLM_PROVIDER is google/anthropic/auto.
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# --- Speech: ASR -------------------------------------------------------------
# parakeet (default, runs in .venv-nvidia-speech) | whisper (legacy).
ASR_BACKEND=parakeet
# Python of the isolated speech runtime. Empty = .venv-nvidia-speech\Scripts\python.exe
NVIDIA_SPEECH_PYTHON=
# Created by: scripts\setup_nvidia_speech.ps1 -DownloadModels
PARAKEET_MODEL_PATH=data/models/nvidia_speech/parakeet
TRANSCRIPTION_LANGUAGE=es
# Only used when ASR_BACKEND=whisper.
WHISPER_MODEL=nekusu/faster-whisper-large-v3-turbo-latam-int8-ct2

# --- Speech: diarization -----------------------------------------------------
# nemotron (default, local model) | pyannote (Community-1, needs HF_TOKEN).
DIARIZATION_BACKEND=nemotron
NEMOTRON_MODEL_PATH=data/models/nvidia_speech/nemotron
# Hugging Face token for the gated pyannote models (pyannote backend only).
HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Python of the pyannote runtime. Empty = .venv-diarization\Scripts\python.exe
# (created by scripts\setup_diarization_env.ps1).
DIARIZATION_PYTHON=
SPEAKER_EMBEDDING_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM

# --- Local models ------------------------------------------------------------
# Folder for the YuNet/SFace face models (see: python -m clipperx.cli setup-face-models).
FACE_MODEL_DIR=data/models/face_identity
# Set to true to let setup-face-models download missing face models.
ALLOW_MODEL_DOWNLOADS=false
# Sentence embedding model (EMBEDDING_MODEL is accepted as an alias).
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Local copy of the style embedding model.
# Empty = data/models/style_embeddings/<EMBED_MODEL basename>.
STYLE_EMBEDDING_MODEL_PATH=

# --- Output and branding -----------------------------------------------------
# Caption style name (python -m clipperx.cli templates lists them).
CAPTION_TEMPLATE=default
CREATOR_HANDLE=kick.com/athanw
BRAND_IMAGE_PATH=assets/branding/KickAthanW.png
# Minimum virality score (0-100) a legacy-pipeline clip needs to be kept.
MIN_VIRALITY_SCORE=0
EXPORT_PRESET=default
# Optional Pexels key for B-roll inserts.
PEXELS_API_KEY=
